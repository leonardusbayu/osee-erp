# Copy this file to .env and edit locally. Process variables take precedence.
# Never commit a real .env or key.
DJANGO_DEBUG=1
OSEE_DEMO_MODE=1
OSEE_LOCAL_SETUP=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production requires DJANGO_DEBUG=0, a generated secret, PostgreSQL, HTTPS,
# protected static hosting, reviewed data and bank/tax integration acceptance.
DJANGO_SECRET_KEY=
POSTGRES_DB=
POSTGRES_USER=osee
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Tax chat: curated public guidance only. This does not configure Director AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=
OPENROUTER_PRIVATE_CONTEXT_ENABLED=0
OPENROUTER_MONTHLY_BUDGET_USD=5
OPENROUTER_MAX_REQUEST_COST_USD=0

# Director adviser uses a separate credential and bounded confidential aggregates.
# Defaults keep all external Director calls off; local briefings still work.
# Before enabling, review endpoint/privacy/pricing and obtain the active owner's
# in-app disclosure approval with positive company and per-request limits.
DIRECTOR_OPENROUTER_API_KEY=
DIRECTOR_OPENROUTER_MODEL=
DIRECTOR_OPENROUTER_PROVIDER=
DIRECTOR_AI_PRIVATE_AGGREGATES_ENABLED=0
DIRECTOR_AI_ENDPOINT_APPROVED=0
# Conservative amount reserved before each dispatch; validate against real pricing.
DIRECTOR_AI_MAX_REQUEST_COST_USD=0
# Shared application-wide monthly admission budget; in-app policy also caps each org.
DIRECTOR_AI_MONTHLY_BUDGET_USD=0
DIRECTOR_AI_USER_MONTHLY_BUDGET_USD=0

# Separate marketing disclosure; Director consent alone does not authorize it.
MARKETING_AI_PRIVATE_AGGREGATES_ENABLED=0
