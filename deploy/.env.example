# Deployment host only: do not use an unconfirmed company domain.
APP_DOMAIN=erp.example.invalid
ACME_EMAIL=ops@example.invalid

# Finance tax guidance uses public source summaries only. Blank provider/model and
# zero per-request cost keep OpenRouter disabled until an administrator configures it.
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=
OPENROUTER_MONTHLY_BUDGET_USD=5
OPENROUTER_MAX_REQUEST_COST_USD=0

# Director AI sends approved aggregate context only after both controls are enabled.
# Keep both approvals off until the owner accepts the provider/data disclosure.
DIRECTOR_OPENROUTER_MODEL=
DIRECTOR_OPENROUTER_PROVIDER=
DIRECTOR_AI_ENDPOINT_APPROVED=0
DIRECTOR_AI_PRIVATE_AGGREGATES_ENABLED=0
DIRECTOR_AI_MAX_REQUEST_COST_USD=0
DIRECTOR_AI_MONTHLY_BUDGET_USD=0
DIRECTOR_AI_USER_MONTHLY_BUDGET_USD=0

# Marketing has a separate disclosure approval and remains disabled by default.
MARKETING_AI_PRIVATE_AGGREGATES_ENABLED=0
